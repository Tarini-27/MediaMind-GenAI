{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MediaMind: run and debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--port", "8765"]
    }
  ]
}
