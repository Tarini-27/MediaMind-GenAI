{"uid": "gather", "title": "Gather agent health", "schemaVersion": 39, "version": 1, "refresh": "15s", "panels": [{"id": 1, "type": "timeseries", "title": "Completed and failed runs", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "sum by(outcome)(gather_runs_total)", "refId": "A"}], "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}}, {"id": 2, "type": "timeseries", "title": "Median response time", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "histogram_quantile(0.5,sum by(le)(rate(gather_run_seconds_bucket[5m])))", "refId": "A"}], "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}}, {"id": 3, "type": "timeseries", "title": "95th percentile response time", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "histogram_quantile(0.95,sum by(le)(rate(gather_run_seconds_bucket[5m])))", "refId": "A"}], "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}}, {"id": 4, "type": "timeseries", "title": "Tools and failures", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "sum by(agent,tool,outcome)(gather_tools_total)", "refId": "A"}], "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}}, {"id": 5, "type": "timeseries", "title": "Reported model tokens", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "sum by(kind)(gather_model_tokens_total)", "refId": "A"}], "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}}, {"id": 6, "type": "timeseries", "title": "Active alerts", "datasource": {"type": "prometheus", "uid": "gather-prom"}, "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "refId": "A"}], "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}}], "time": {"from": "now-1h", "to": "now"}}