# Copy to .env if you want persistent local configuration.
# Alternatively, enter keys in the app's Model connection interface.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Set this to a text model your course OpenRouter account can access.
AGENT_MODEL=

# Leave GEMINI_MODEL unset to use the application's existing default.
# GEMINI_MODEL=
RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L2-v2

# Optional guard classifier; leave blank until a compatible model is chosen.
GUARD_MODEL=
GUARD_API_KEY=
